{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "bongo-champs",
    "main": "src/index.js",
    "compatibility_date": "2026-09-01",
    "durable_objects": {
        "bindings": [
            { "name": "ROOMS", "class_name": "Room" }
        ]
    },
    // SQLite-backed Durable Objects are the ones available on the Workers Free plan.
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Room"] }
    ],
    "observability": {
        "enabled": true
    }
}
